{
  "routes": [
    { "route": "/runtime-config.js", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/api-client.js", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/lad-brand.js", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/lad-brand.css", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/*.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/", "rewrite": "/clpd-portal.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/lawyer", "rewrite": "/lawyer-portal-v2.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/firm", "rewrite": "/firm-compliance-portal.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/intelligence", "rewrite": "/lad-crm.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/crm", "rewrite": "/lad-crm.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/admin", "rewrite": "/lad-crm.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/oversight", "rewrite": "/lad-crm.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/accreditation", "rewrite": "/lad-accreditation-review.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/heatmap", "rewrite": "/lad-capability-heatmap.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/skills", "rewrite": "/lawyer-skills.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/router", "rewrite": "/router.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/users", "rewrite": "/users-admin.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/change-password", "rewrite": "/change-password.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/firm-capabilities", "rewrite": "/firm-capabilities.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/provider", "rewrite": "/provider-portal.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/training-provider", "rewrite": "/provider-portal.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/command", "rewrite": "/command-centre.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/twin", "rewrite": "/command-centre.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/staff-training", "rewrite": "/lad-staff-training.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/rate", "rewrite": "/rate-course.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/feedback", "rewrite": "/rate-course.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/support", "rewrite": "/help.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/my-learning", "rewrite": "/my-learning.html", "headers": { "cache-control": "no-store, must-revalidate" } },
    { "route": "/learning-admin", "rewrite": "/lad-learning-admin.html", "headers": { "cache-control": "no-store, must-revalidate" } },

    { "route": "/ladstaff", "redirect": "/lad-staff-training.html", "statusCode": 302 },
    { "route": "/ladstaff/*", "redirect": "/lad-staff-training.html", "statusCode": 302 },
    { "route": "/ladtrain", "redirect": "/lad-staff-training.html", "statusCode": 302 },
    { "route": "/ladtrain/*", "redirect": "/lad-staff-training.html", "statusCode": 302 },
    { "route": "/servicehub", "redirect": "/hub.html?course=aviation-law", "statusCode": 302 },
    { "route": "/servicehub/*", "redirect": "/hub.html?course=aviation-law", "statusCode": 302 },
    { "route": "/reception", "redirect": "/", "statusCode": 302 },
    { "route": "/reception/*", "redirect": "/", "statusCode": 302 },
    { "route": "/ai-trainer", "redirect": "/ai-trainer.html", "statusCode": 302 }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/img/*",
      "/fonts/*",
      "/courses/*",
      "/*.{html,css,js,json,png,jpg,jpeg,svg,ico,woff,woff2,webmanifest}",
      "/api/*"
    ]
  },
  "globalHeaders": {
    "X-Frame-Options": "SAMEORIGIN",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains; preload",
    "Permissions-Policy": "camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net https://legal.dubai.gov.ae; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https://lad-clpd-backend.onrender.com https://api.anam.ai wss://api.anam.ai https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://storage.googleapis.com https://tfhub.dev https://www.kaggle.com; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".woff2": "font/woff2",
    ".woff": "font/woff",
    ".svg": "image/svg+xml",
    ".webmanifest": "application/manifest+json"
  }
}
